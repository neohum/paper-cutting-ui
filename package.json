{
  "name": "paper-cutting-ui",
  "version": "1.0.0",
  "type": "module",
  "description": "PaperCut UI - 3D Layered Paper-Craft Design System & UI Components with instant copy-paste and CLI support",
  "main": "papercut.js",
  "module": "papercut.js",
  "style": "papercut.css",
  "bin": {
    "paper-cutting-ui": "./bin/papercut.mjs",
    "papercut-ui": "./bin/papercut.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neohum/paper-cutting-ui.git"
  },
  "bugs": {
    "url": "https://github.com/neohum/paper-cutting-ui/issues"
  },
  "homepage": "https://github.com/neohum/paper-cutting-ui#readme",
  "exports": {
    ".": {
      "import": "./papercut.js",
      "default": "./papercut.js"
    },
    "./css": "./papercut.css",
    "./svg-primitives.css": "./papercut-svg-primitives.css",
    "./primitives": "./papercut-svg-primitives.js",
    "./icons": "./papercut-icons.js",
    "./backgrounds": "./papercut-backgrounds.js"
  },
  "files": [
    "bin",
    "papercut.css",
    "papercut.js",
    "papercut-svg-primitives.css",
    "papercut-svg-primitives.js",
    "papercut-icons.js",
    "papercut-backgrounds.js",
    "papercut-alerts-toasts.css",
    "papercut-alerts-toasts.js",
    "papercut-blocks-charts.css",
    "papercut-blocks-charts.js",
    "papercut-modals.css",
    "papercut-modals.js",
    "papercut-sidebar.css",
    "papercut-sidebar.js",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "papercut",
    "paper-craft",
    "ui",
    "components",
    "svg",
    "radix",
    "kirigami",
    "design-system"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev/live-server.mjs",
    "serve": "node scripts/dev/live-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:physics": "node --test tests/wood-shaving-curl.test.mjs tests/paper-flutter-scatter.test.mjs tests/kirigami-interactions.test.mjs tests/dynamic-light-shadow.test.mjs tests/perf-fps.test.mjs",
    "inspect:visual": "node --experimental-strip-types scripts/visual-inspector/inspect-web.ts",
    "test:overflow": "node scripts/ops/verify-overflow.mjs --page && node scripts/ops/verify-overflow.mjs --fixtures"
  },
  "devDependencies": {
    "playwright-core": "1.48.2"
  }
}
